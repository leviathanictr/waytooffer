# Example environment for backend — copy to `backend/.env` on the server
# Fill values with real secrets; do NOT commit `backend/.env` with secrets.

# CORS: allowed origins (comma-separated)
CORS_ORIGINS="https://waytooffer.ru"

# OpenAI

OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# JWT secret
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# SMSC (leave empty for development; SMS codes will be printed to logs)
SMSC_LOGIN=""
SMSC_PASSWORD=""

# SMTP (Yandex example)
SMTP_SERVER="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="waytooffer@yandex.ru"
SMTP_PASSWORD="YOUR_SMTP_APP_PASSWORD"

# Database — if you want Postgres, set DATABASE_URL accordingly, for example:
# DATABASE_URL=postgresql+psycopg://resume:resume_pass@postgres:5432/resume_db
# If empty, the default fallback is sqlite.
DATABASE_URL="sqlite:////data/resume_builder.db"
# ─── Деплой: что менять при переезде на сервер ───────────────────────────────
# 1. CORS_ORIGINS       — домен(а) фронтенда (через запятую)
# 2. NEXT_PUBLIC_API_URL в frontend/.env.local — адрес этого бэкенда
# 3. JWT_SECRET         — любая длинная случайная строка
# 4. OPENAI_API_KEY     — ключ OpenAI
# 5. SMSC_*             — реквизиты smsc.ru для SMS
# 6. SMTP_*             — реквизиты Яндекс Почты для email
# ─────────────────────────────────────────────────────────────────────────────

# CORS: разрешённые адреса фронтенда (через запятую, без пробелов)
# Dev:        CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Prod:       CORS_ORIGINS=https://waytooffer.ru
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

OPENAI_API_KEY=sk-...
JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars

# SMSC.ru — SMS
# Оставьте пустыми для dev-режима: коды будут печататься в консоль бэкенда
SMSC_LOGIN=
SMSC_PASSWORD=

# SMTP для Email (Яндекс Почта)
# Пароль приложения: Яндекс ID → Безопасность → Пароли приложений
SMTP_SERVER=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your_login@yandex.ru
SMTP_PASSWORD=your_app_password
